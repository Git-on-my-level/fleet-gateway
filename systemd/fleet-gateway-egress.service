[Unit]
Description=Optional fleet gateway Docker egress lockdown
Before=fleet-gateway.service
After=network.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/fleet-gateway/egress.nft
ExecReload=/usr/sbin/nft -f /etc/fleet-gateway/egress.nft
ExecStop=-/usr/sbin/nft delete table inet fleet_gateway
[Install]
WantedBy=multi-user.target
