# Tokenless listener. Installer resolves Tailscale IPv4; no implicit public bind.
FLEET_GATEWAY_BIND_HOST=
FLEET_GATEWAY_PORT=9494
# One active container; finite FIFO waiting capacity.
FLEET_GATEWAY_QUEUE_CAPACITY=8
FLEET_GATEWAY_IMAGE=fleet-gateway-worker:1
WORKER_ROOT=/var/lib/fleet-gateway
FLEET_GATEWAY_AUDIT=/var/log/fleet-gateway/runs.jsonl
# Admission reserve in bytes (2 GiB); terminal retention from completion (1h).
FLEET_GATEWAY_DISK_RESERVE=2147483648
FLEET_GATEWAY_RETENTION_SECONDS=3600
# Fixed v1 bounds: request 1 MiB, log 8 MiB, uncompressed tar 512 MiB,
# execution default 900s/max 3600s, idempotency 24h, read timeout 15s.
# Container caps: memory/swap 2g, CPUs 2, PIDs 256; concurrency fixed at 1.
